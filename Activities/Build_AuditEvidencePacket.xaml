#xD;&#xA;&#xD;&#xA;if (System.IO.Directory.Exists(stagingDir))&#xD;&#xA;    System.IO.Directory.Delete(stagingDir, true);&#xD;&#xA;System.IO.Directory.CreateDirectory(stagingDir);&#xD;&#xA;&#xD;&#xA;// Copy audit log into staging&#xD;&#xA;string stagedLogName = System.IO.Path.GetFileName(in_AuditLogPath);&#xD;&#xA;System.IO.File.Copy(in_AuditLogPath, System.IO.Path.Combine(stagingDir, stagedLogName));&#xD;&#xA;&#xD;&#xA;// ── 5. Build manifest ────────────────────────────────────────────────&#xD;&#xA;string builtAt = System.DateTime.UtcNow.ToString(&quot;o&quot;); // ISO 8601&#xD;&#xA;&#xD;&#xA;var manifestObj = new Newtonsoft.Json.Linq.JObject&#xD;&#xA;{&#xD;&#xA;    [&quot;schema_version&quot;] = &quot;atlas.compliance.evidence.v1&quot;,&#xD;&#xA;    [&quot;packet_id&quot;]      = resolvedPacketId,&#xD;&#xA;    [&quot;built_at&quot;]       = builtAt,&#xD;&#xA;    [&quot;nist_controls&quot;]  = new Newtonsoft.Json.Linq.JArray(&quot;AU-4&quot;, &quot;AU-11&quot;, &quot;AU-12&quot;),&#xD;&#xA;    [&quot;files&quot;] = new Newtonsoft.Json.Linq.JArray(&#xD;&#xA;        new Newtonsoft.Json.Linq.JObject&#xD;&#xA;        {&#xD;&#xA;            [&quot;name&quot;]   = stagedLogName,&#xD;&#xA;            [&quot;bytes&quot;]  = auditLogBytes,&#xD;&#xA;            [&quot;sha256&quot;] = auditLogHash&#xD;&#xA;        }&#xD;&#xA;    )&#xD;&#xA;};&#xD;&#xA;&#xD;&#xA;manifestJson = manifestObj.ToString(Newtonsoft.Json.Formatting.Indented);&#xD;&#xA;&#xD;&#xA;// Write manifest into staging dir&#xD;&#xA;System.IO.File.WriteAllText(&#xD;&#xA;    System.IO.Path.Combine(stagingDir, &quot;manifest.json&quot;),&#xD;&#xA;    manifestJson,&#xD;&#xA;    System.Text.Encoding.UTF8);&#xD;&#xA;&#xD;&#xA;// ── 6. Create ZIP from staging dir ───────────────────────────────────&#xD;&#xA;string outDir = System.IO.Path.GetDirectoryName(in_OutputZipPath);&#xD;&#xA;if (!string.IsNullOrWhiteSpace(outDir) &amp;&amp; !System.IO.Directory.Exists(outDir))&#xD;&#xA;    System.IO.Directory.CreateDirectory(outDir);&#xD;&#xA;&#xD;&#xA;System.IO.Compression.ZipFile.CreateFromDirectory(&#xD;&#xA;    stagingDir,&#xD;&#xA;    in_OutputZipPath,&#xD;&#xA;    System.IO.Compression.CompressionLevel.Optimal,&#xD;&#xA;    false);&#xD;&#xA;&#xD;&#xA;// ── 7. Cleanup staging dir ───────────────────────────────────────────&#xD;&#xA;System.IO.Directory.Delete(stagingDir, true);&#xD;&#xA;&#xD;&#xA;// ── 8. Assign outputs ────────────────────────────────────────────────&#xD;&#xA;resolvedZipPath = in_OutputZipPath;&#xD;&#xA;out_PacketId    = resolvedPacketId;&#xD;&#xA;out_ZipPath     = resolvedZipPath;&#xD;&#xA;out_ManifestJson = manifestJson;" DisplayName="Invoke Code" sap:VirtualizedContainerService.HintSize="450,188" sap2010:WorkflowViewState.IdRef="InvokeCode_1" Language="CSharp">
