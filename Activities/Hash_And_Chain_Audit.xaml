    <ui:InvokeCode ContinueOnError="{x:Null}" Code="if (string.IsNullOrEmpty(currentRecord))&#xD;&#xA;{&#xD;&#xA;    throw new ArgumentException(&quot;CurrentRecord cannot be null or empty. The hash chain requires a real audit record to hash.&quot;, &quot;currentRecord&quot;);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;string prevHash = previousHash ?? &quot;&quot;;&#xD;&#xA;&#xD;&#xA;using (var sha256 = System.Security.Cryptography.SHA256.Create())&#xD;&#xA;{&#xD;&#xA;    // Compute SHA-256 of just the current record (deterministic, used for direct verification)&#xD;&#xA;    byte[] recordBytes = System.Text.Encoding.UTF8.GetBytes(currentRecord);&#xD;&#xA;    byte[] recordHashBytes = sha256.ComputeHash(recordBytes);&#xD;&#xA;    recordHash = BitConverter.ToString(recordHashBytes).Replace(&quot;-&quot;, &quot;&quot;).ToLowerInvariant();&#xD;&#xA;&#xD;&#xA;    // Compute chained hash: SHA-256 of (previousHash + currentRecord)&#xD;&#xA;    // For the first record in a chain, previousHash is empty, so chainedHash == hash(&quot;&quot; + record) == hash(record) == recordHash&#xD;&#xA;    byte[] chainBytes = System.Text.Encoding.UTF8.GetBytes(prevHash + currentRecord);&#xD;&#xA;    byte[] chainHashBytes = sha256.ComputeHash(chainBytes);&#xD;&#xA;    chainedHash = BitConverter.ToString(chainHashBytes).Replace(&quot;-&quot;, &quot;&quot;).ToLowerInvariant();&#xD;&#xA;}" DisplayName="Compute SHA-256 hashes" sap:VirtualizedContainerService.HintSize="450,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_1" Language="CSharp">
