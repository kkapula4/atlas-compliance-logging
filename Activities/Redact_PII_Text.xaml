    <ui:InvokeCode ContinueOnError="{x:Null}" Code="workingText = string.IsNullOrEmpty(inputText) ? &quot;&quot; : inputText;&#xD;&#xA;redactionCount = 0;&#xD;&#xA;detectedTypes.Clear();&#xD;&#xA;&#xD;&#xA;if (redactSSN &amp;&amp; !string.IsNullOrEmpty(workingText))&#xD;&#xA;{&#xD;&#xA;    var pattern = @&quot;\b\d{3}-\d{2}-\d{4}\b&quot;;&#xD;&#xA;    var matches = System.Text.RegularExpressions.Regex.Matches(workingText, pattern);&#xD;&#xA;    if (matches.Count &gt; 0)&#xD;&#xA;    {&#xD;&#xA;        workingText = System.Text.RegularExpressions.Regex.Replace(workingText, pattern, replacement);&#xD;&#xA;        redactionCount += matches.Count;&#xD;&#xA;        detectedTypes.Add(&quot;ssn&quot;);&#xD;&#xA;    }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;if (redactAccount &amp;&amp; !string.IsNullOrEmpty(workingText))&#xD;&#xA;{&#xD;&#xA;    var pattern = @&quot;\b(?:\d[ -]*?){13,19}\b&quot;;&#xD;&#xA;    var matches = System.Text.RegularExpressions.Regex.Matches(workingText, pattern);&#xD;&#xA;    if (matches.Count &gt; 0)&#xD;&#xA;    {&#xD;&#xA;        workingText = System.Text.RegularExpressions.Regex.Replace(workingText, pattern, replacement);&#xD;&#xA;        redactionCount += matches.Count;&#xD;&#xA;        detectedTypes.Add(&quot;account&quot;);&#xD;&#xA;    }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;if (redactPhone &amp;&amp; !string.IsNullOrEmpty(workingText))&#xD;&#xA;{&#xD;&#xA;    var pattern = @&quot;\b(?:\+?1[-.\s]?)?\(?\d{3}\)?[-.\s]?\d{3}[-.\s]?\d{4}\b&quot;;&#xD;&#xA;    var matches = System.Text.RegularExpressions.Regex.Matches(workingText, pattern);&#xD;&#xA;    if (matches.Count &gt; 0)&#xD;&#xA;    {&#xD;&#xA;        workingText = System.Text.RegularExpressions.Regex.Replace(workingText, pattern, replacement);&#xD;&#xA;        redactionCount += matches.Count;&#xD;&#xA;        detectedTypes.Add(&quot;phone&quot;);&#xD;&#xA;    }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;if (redactEmail &amp;&amp; !string.IsNullOrEmpty(workingText))&#xD;&#xA;{&#xD;&#xA;    var pattern = @&quot;\b[\w.